APP_NAME="キゲンバン：社労士業務進捗管理"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SALES_CONTACT_EMAIL=hello@example.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=en_US

# 運営者向け顧客(office)管理画面（/admin）にログインする、唯一の運営者アカウント
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ローカル開発ではMinIO（S3互換、Sailに同梱）を使う。本番は7.7章の方針に従いS3互換の
# マネージドストレージ（AWS S3・さくらのオブジェクトストレージ等）に値を差し替える。
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local
AWS_URL=http://localhost:9000/local
AWS_ENDPOINT=http://minio:9000
# 署名付きURLをブラウザから開けるようにするための公開エンドポイント（ローカル開発専用。
# 本番のS3互換マネージドストレージではAWS_ENDPOINTと同一のため未設定でよい）
AWS_ENDPOINT_URL_PUBLIC=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# MinIO組み込みの簡易KMS用キー（SSE-S3をKESなしで有効化する）。`openssl rand -base64 32`で生成し、
# `任意の名前:生成したbase64値` の形式で設定する。
MINIO_KMS_SECRET_KEY=

VAPID_SUBJECT="mailto:admin@example.com"

# デスクトップ通知アプリのインストーラーをGitHub Releases（private repo）から配布するために使う。
# 対象リポジトリの Contents: Read-only 権限のみを持つ Fine-grained PAT を発行して設定する
# （未設定の場合、設定画面のダウンロード欄は「準備中」表示になるだけで他機能には影響しない）。
GITHUB_TOKEN=
GITHUB_DESKTOP_APP_REPO=michimuko/syaroushi
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# エラー監視（Sentry）。未設定ならSDKは自動的に無効化されるため開発中は空でよい
SENTRY_LARAVEL_DSN=

# 契約プランの決済（Checkout Sessions + Customer Portal）。ローカル開発ではStripeサンドボックスの
# キーを使う。STRIPE_WEBHOOK_SECRETは `stripe listen --forward-to localhost/webhooks/stripe` 実行時に
# 表示される whsec_... の値（本番はStripeダッシュボードのWebhook設定画面で発行される値）
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
