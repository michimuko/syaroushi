# 本番用 .env テンプレート（さくらのVPS 2GBプラン + Cloudflare R2）
# .env.example との差分のみコメントで補足している。実際の値に書き換えたうえで
# /var/www/syaroushi/.env として配置する（このファイル自体はコミットしない）。

APP_NAME="社労士業務進捗管理"
APP_ENV=production
APP_KEY=
# php artisan key:generate で生成する（本番サーバー上で一度だけ実行）
APP_DEBUG=false
# 本番でtrueのままだと例外発生時にスタックトレース・環境変数が画面に露出するため必須で変更
APP_URL=https://korotane.site

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
# 本番はdebugだとログ肥大化が早いのでinfoに落とす

# --- DB: さくらのVPSにセットアップしたMySQL（deploy/mysql/syaroushi.cnf適用済み想定） ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=syaroushi
DB_USERNAME=syaroushi
DB_PASSWORD=
# 強力なランダムパスワードを生成して設定（openssl rand -base64 24 等）

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
# HTTPS配信前提のため必須でtrueにする（デフォルトnullだとApp::environment()依存で挙動が曖昧になる）
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database
# VPS単体構成でRedisを別途動かす余裕がないため、当面はdatabaseドライバのままでよい
# （将来スケールしてボトルネックになった場合にRedis導入を検討）

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@korotane.site"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
# 通知メール（procedures:send-reminders等）が届かないと本機能の中核が機能しないため必須で契約・設定する。
# Resend無料枠（3,000通/月・100通/日）で当面は十分足りる見込み。resend.comでアカウント作成後、
# 送信元ドメイン（korotane.site）のDNS認証（SPF/DKIM）を済ませてからAPI Keyを発行する
# （ドメイン未認証のうちはResendのテスト用アドレスからしか送れない）。
# MAIL_FROM_ADDRESSは認証したドメインのアドレスに合わせること。

# --- Cloudflare R2（S3互換、書類チェックリスト・PDFレポートの保存先） ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# CloudflareダッシュボードでR2バケット作成後、「S3 API」の項目に表示されるAccess Key ID /
# Secret Access Key / Bucketを設定する（R2トークンはAPIトークンではなくR2用のものを発行すること）
AWS_URL=
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# <ACCOUNT_ID>はCloudflareダッシュボードのアカウントIDに置き換える
AWS_ENDPOINT_URL_PUBLIC=
# 本番は単一エンドポイントで完結するため未設定のままでよい（MinIO開発環境のみで使う値）
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_KMS_SECRET_KEY=
# R2はサーバー側で常時AES-256暗号化されるためMinIO専用のこの値は不要（空のままでよい）

VAPID_SUBJECT="mailto:admin@korotane.site"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 開発環境の鍵を使い回さず、本番サーバー上で php artisan webpush:vapid を実行して
# 本番専用の鍵を新規発行すること（秘密鍵は開発と本番で共有しない）

# --- エラー監視（Sentry、無料枠 Developer プラン: 5,000エラー/月） ---
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# パフォーマンストレースは無料枠の別クォータを消費するため、当面はエラー監視のみに絞って明示的に0にする。
# sentry.io でプロジェクト作成（Platform: Laravel）後、発行されたDSNを設定する。

GITHUB_TOKEN=
GITHUB_DESKTOP_APP_REPO=michimuko/syaroushi

VITE_APP_NAME="${APP_NAME}"
